APP_NAME="Hospital Health Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Central (Landlord) Database
DB_CONNECTION=mysql
DB_HOST=mysql_central
DB_PORT=3306
DB_DATABASE=hhms_central
DB_USERNAME=hhms_user
DB_PASSWORD=hhms_password

# Tenant Database Connection Template
TENANT_DB_HOST=mysql_central
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=hhms_user
TENANT_DB_PASSWORD=hhms_password

BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@hhms.app"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 Configuration (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Soketi WebSocket Configuration (Pusher-compatible)
PUSHER_APP_ID=hhms-app
PUSHER_APP_KEY=hhms-app-key
PUSHER_APP_SECRET=hhms-app-secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# JWT Configuration
JWT_SECRET=
JWT_TTL=720
JWT_REFRESH_TTL=10080

# Tenancy Configuration
TENANCY_DATABASE_AUTO_DELETE=false
TENANCY_DATABASE_AUTO_DELETE_USER=false

# Super Admin seed credentials (used only during: php artisan db:seed)
SUPER_ADMIN_NAME="System Administrator"
SUPER_ADMIN_EMAIL=admin@hhms.app
SUPER_ADMIN_PASSWORD=ChangeMe!2024#

# SMS Gateway (twilio | vonage | africastalking | null)
SMS_DRIVER=null
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=
TWILIO_FROM=

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS=

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com,https://admin.example.com)
CORS_ALLOWED_ORIGINS=

# TLS Certificate paths (for docker-compose.prod.yml)
SSL_CERT_PATH=./docker/nginx/ssl/cert.pem
SSL_KEY_PATH=./docker/nginx/ssl/key.pem

# Soketi production credentials
SOKETI_APP_ID=hhms-app
SOKETI_APP_KEY=
SOKETI_APP_SECRET=

# MySQL root password (Docker only)
MYSQL_ROOT_PASSWORD=
